# Board schematic pages5/12: BANK87 VCCO3.3V, external1k pull-ups on SCL/SDA.
set_property -dict {PACKAGE_PIN AB21 IOSTANDARD LVCMOS18} [get_ports SYS_CLK]
create_clock -name monitor_clk -period 10.000 [get_ports SYS_CLK]
set_property -dict {PACKAGE_PIN F14 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports SI5338_SCL]
set_property -dict {PACKAGE_PIN F13 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports SI5338_SDA]
set_property -dict {PACKAGE_PIN E13 IOSTANDARD LVCMOS33} [get_ports SI5338_INTR]
set_property -dict {PACKAGE_PIN E12 IOSTANDARD LVCMOS33} [get_ports SI5338_I2C_LSB]
set_property -dict {PACKAGE_PIN D13 IOSTANDARD LVCMOS33} [get_ports CLK_SEL]
set_property -dict {PACKAGE_PIN AF14 IOSTANDARD LVCMOS33} [get_ports LED1]
set_property -dict {PACKAGE_PIN AF15 IOSTANDARD LVCMOS33} [get_ports LED2]
set_false_path -to [get_ports {LED1 LED2}]
set_false_path -from [get_ports {SI5338_SCL SI5338_SDA SI5338_INTR SI5338_I2C_LSB CLK_SEL}]
set_false_path -to [get_pins -hier -filter {NAME =~ *reader/scl_meta_reg/D || NAME =~ *reader/sda_meta_reg/D || NAME =~ *strap_meta_reg*/D}]
create_generated_clock -name capture_clk -source [get_ports SYS_CLK] -divide_by 8 [get_pins capture_buffer/O]
