# Authored subset cross-checked against schematic pages 3, 6 and 16 (PDF index).
# PERSTn is level-translated to BANK65 VCCO=1.2 V; SYS_CLK is BANK64 1.8 V.
set_property -dict {PACKAGE_PIN AB21 IOSTANDARD LVCMOS18} [get_ports SYS_CLK]
create_clock -name monitor_clk -period 10.000 [get_ports SYS_CLK]
set_property -dict {PACKAGE_PIN AF14 IOSTANDARD LVCMOS33} [get_ports LED1]
set_property -dict {PACKAGE_PIN AF15 IOSTANDARD LVCMOS33} [get_ports LED2]
set_false_path -to [get_ports {LED1 LED2}]
set_property PACKAGE_PIN AB7 [get_ports pcie_refclk_p]
set_property PACKAGE_PIN AB6 [get_ports pcie_refclk_n]
create_clock -name pcie_mgt_refclk -period 10.000 [get_ports pcie_refclk_p]
set_property -dict {PACKAGE_PIN T19 IOSTANDARD LVCMOS12} [get_ports pcie_reset_n]
set_property PACKAGE_PIN P2 [get_ports {pcie_rx_p[0]}]
set_property PACKAGE_PIN T2 [get_ports {pcie_rx_p[1]}]
set_property PACKAGE_PIN V2 [get_ports {pcie_rx_p[2]}]
set_property PACKAGE_PIN Y2 [get_ports {pcie_rx_p[3]}]
set_property PACKAGE_PIN AB2 [get_ports {pcie_rx_p[4]}]
set_property PACKAGE_PIN AD2 [get_ports {pcie_rx_p[5]}]
set_property PACKAGE_PIN AE4 [get_ports {pcie_rx_p[6]}]
set_property PACKAGE_PIN AF2 [get_ports {pcie_rx_p[7]}]
set_property PACKAGE_PIN P1 [get_ports {pcie_rx_n[0]}]
set_property PACKAGE_PIN T1 [get_ports {pcie_rx_n[1]}]
set_property PACKAGE_PIN V1 [get_ports {pcie_rx_n[2]}]
set_property PACKAGE_PIN Y1 [get_ports {pcie_rx_n[3]}]
set_property PACKAGE_PIN AB1 [get_ports {pcie_rx_n[4]}]
set_property PACKAGE_PIN AD1 [get_ports {pcie_rx_n[5]}]
set_property PACKAGE_PIN AE3 [get_ports {pcie_rx_n[6]}]
set_property PACKAGE_PIN AF1 [get_ports {pcie_rx_n[7]}]
set_property PACKAGE_PIN R5 [get_ports {pcie_tx_p[0]}]
set_property PACKAGE_PIN U5 [get_ports {pcie_tx_p[1]}]
set_property PACKAGE_PIN W5 [get_ports {pcie_tx_p[2]}]
set_property PACKAGE_PIN AA5 [get_ports {pcie_tx_p[3]}]
set_property PACKAGE_PIN AC5 [get_ports {pcie_tx_p[4]}]
set_property PACKAGE_PIN AD7 [get_ports {pcie_tx_p[5]}]
set_property PACKAGE_PIN AE9 [get_ports {pcie_tx_p[6]}]
set_property PACKAGE_PIN AF7 [get_ports {pcie_tx_p[7]}]
set_property PACKAGE_PIN R4 [get_ports {pcie_tx_n[0]}]
set_property PACKAGE_PIN U4 [get_ports {pcie_tx_n[1]}]
set_property PACKAGE_PIN W4 [get_ports {pcie_tx_n[2]}]
set_property PACKAGE_PIN AA4 [get_ports {pcie_tx_n[3]}]
set_property PACKAGE_PIN AC4 [get_ports {pcie_tx_n[4]}]
set_property PACKAGE_PIN AD6 [get_ports {pcie_tx_n[5]}]
set_property PACKAGE_PIN AE8 [get_ports {pcie_tx_n[6]}]
set_property PACKAGE_PIN AF6 [get_ports {pcie_tx_n[7]}]
# Only the first synchronizer stage is asynchronous. No broad clock-domain cut.
set_false_path -to [get_pins -hier -filter {NAME =~ *monitor_sync1_reg*/D}]
set_false_path -to [get_pins -hier -filter {NAME =~ *clock_monitor/sample1_reg*/D}]
# PCIe PERSTn is the documented asynchronous reset input to the IP.
set_false_path -from [get_ports pcie_reset_n]
